# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Authentication
JWT_SECRET=your_jwt_secret_here_minimum_32_characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Agora Voice Chat
NEXT_PUBLIC_AGORA_APP_ID=your_agora_app_id

# Payment Gateway (pawaPay)
PAWAPAY_API_KEY=your_pawapay_api_key
PAWAPAY_SECRET=your_pawapay_secret
PAWAPAY_BASE_URL=https://api.pawapay.io

# SMS Gateway
SMS_GATEWAY_KEY=your_sms_gateway_key
SMS_GATEWAY_URL=https://api.sms-gateway.com

# API Configuration
API_BASE_URL=http://localhost:3000
NODE_ENV=development

# App Configuration
NEXT_PUBLIC_APP_NAME=Rival
NEXT_PUBLIC_APP_DESCRIPTION=P2P Gaming Platform
NEXT_PUBLIC_MIN_STAKE=500
NEXT_PUBLIC_MAX_STAKE=50000